<mujoco model="so101_pick_real_block">
    <include file="so101.xml" />

    <visual>
        <headlight diffuse="0.45 0.45 0.45" ambient="0.3 0.3 0.3" specular="0 0 0" />
        <rgba haze="0.75 0.85 0.95 1" />
        <global azimuth="160" elevation="-20" offwidth="1280" offheight="960" />
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.35 0.55 0.9" rgb2="0.75 0.85 0.95"
            width="512" height="3072" />
        <texture type="2d" name="groundplane" builtin="checker"
            rgb1="0.93 0.93 0.93" rgb2="0.80 0.80 0.80" width="64" height="64" />
        <material name="groundplane" texture="groundplane" texuniform="true"
            texrepeat="5 5" reflectance="0" specular="0.1" />
        <!-- Centered, millimeter-unit tessellation of the supplied 40x40x60 mm STEP. -->
        <mesh name="red_box_rounded" file="red_box_rounded.stl" scale="0.001 0.001 0.001" />
    </asset>

    <worldbody>
        <light pos="0 0 3.5" dir="0 0 -1" directional="true" diffuse="0.3 0.3 0.3" />
        <camera name="front" pos="0.45 0.45 0.40" xyaxes="-0.914 0.406 0.000 -0.235 -0.529 0.815" />
        <camera name="overhead" pos="0.20 0.04 0.52" xyaxes="1 0 0 0 1 0"
            fovy="69.5" resolution="1280 720" />
        <geom name="floor" size="0 0 0.05" pos="0 0 0" type="plane" material="groundplane" />

        <!-- Supplied STEP: 40x40x60 mm with R1 mm fillets; measured mass 28.6 g. -->
        <body name="block" pos="0.25 0.0 0.03">
            <freejoint name="block_free" />
            <geom type="mesh" mesh="red_box_rounded" name="block_geom" mass="0.0286" condim="3"
                friction="0.5 .03 .003" rgba="0.9 0.15 0.15 1" contype="2" conaffinity="1"
                solref="0.01 1" />
        </body>

        <body name="ball" pos="0.20 -0.12 0.021">
            <freejoint />
            <geom type="sphere" size="0.02" mass="0.05" rgba="0.2 0.4 0.9 1" />
        </body>

        <site name="target_zone" type="cylinder" pos="0.15 0.18 0.001" size="0.05 0.001"
            rgba="0.15 0.75 0.3 0.9" />
    </worldbody>

    <!-- Explicit pair lets the environment vary table friction without also changing jaw friction. -->
    <contact>
        <pair name="block_floor_contact" geom1="block_geom" geom2="floor" condim="3"
            friction="0.5 0.5 0.03 0.003 0.003" solref="0.01 1" />
    </contact>
</mujoco>
